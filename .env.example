# Master mode switch (preconfigured | manual).
#   preconfigured -> forces every component on, ignoring the per-component knobs
#                    below (AUTO_POPULATE, KC_LDAP_USERS_MODE, KC_FEDERATION_MODE).
#   manual        -> defers to each per-component knob, so a component is
#                    preconfigured only when its own knob says so.
LAB_MODE=preconfigured

# Per-component knob: LDAP seed users, groups, and the Keycloak service account.
# Ignored when LAB_MODE=preconfigured. Set to false for an empty teaching LDAP.
AUTO_POPULATE=true
LDAP_RTI_BASE_DN=dc=rti,dc=etf,dc=bg,dc=ac,dc=rs
LDAP_SI_BASE_DN=dc=si,dc=etf,dc=bg,dc=ac,dc=rs
LDAP_RTI_ADMIN_PASSWORD=change-rti-admin-password
LDAP_SI_ADMIN_PASSWORD=change-si-admin-password

# Keycloak automation modes (preconfigured | manual). Ignored when LAB_MODE=preconfigured.
# KC_LDAP_USERS_MODE  -> LDAP user federation, attribute + group mappers, app clients
# KC_FEDERATION_MODE  -> Keycloak-to-Keycloak OIDC/SAML identity-provider brokering
KC_LDAP_USERS_MODE=manual
KC_FEDERATION_MODE=manual

# Cross-realm brokered logout (single logout across both Keycloaks).
#   off -> logout stays in the initiating realm (avoids the bidirectional
#          brokering logout loop).
#   on  -> a brokered logout also ends the upstream realm's SSO session, but a
#          user whose session chains RTI->SI->RTI can hit an infinite logout loop. Default.
KC_FEDERATION_LOGOUT_PROPAGATION=on
KEYCLOAK_VERSION=26.0
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-keycloak-admin-password
KEYCLOAK_A_HTTP_PORT=8081
KEYCLOAK_B_HTTP_PORT=8082
KEYCLOAK_A_HOSTNAME=http://rti.localhost:8081
KEYCLOAK_B_HOSTNAME=http://si.localhost:8082
KEYCLOAK_A_REALM=rti
KEYCLOAK_B_REALM=si
KEYCLOAK_LDAP_BIND_PASSWORD=change-ldap-keycloak-bind-password
WEBAPP_A_REDIRECT_URI=http://localhost:3000/*
WEBAPP_B_ACS_URL=http://localhost:4000/saml/acs
WEBAPP_B_SLS_URL=http://localhost:4000/saml/sls

# SSO session timeouts in seconds (short for the Web App B SSO countdown demo)
SSO_SESSION_IDLE_TIMEOUT=300
SSO_SESSION_MAX_LIFESPAN=300

# Web Application A (React SPA, OIDC public client with PKCE)
WEBAPP_A_OIDC_AUTHORITY=http://rti.localhost:8081/realms/rti
WEBAPP_A_OIDC_CLIENT_ID=webapp-rti-oauth2
WEBAPP_A_OIDC_REDIRECT_URI=http://localhost:3000
WEBAPP_A_API_BASE_URL=http://localhost:5000

# Web Application B (React frontend + Express SAML SP backend)
WEBAPP_B_FRONTEND_URL=http://localhost:4000
WEBAPP_B_SAML_ENTRY_POINT=http://si.localhost:8082/realms/si/protocol/saml
WEBAPP_B_SAML_IDP_ISSUER=http://si.localhost:8082/realms/si
WEBAPP_B_SAML_ISSUER=webapp-si-saml
WEBAPP_B_SAML_METADATA_URL=http://keycloak-si:8080/realms/si/protocol/saml/descriptor
WEBAPP_B_SESSION_SECRET=change-webapp-si-saml-session-secret

# OAuth 2.0 protected API (Stage 6 resource server)
# Accepts Keycloak A (rti) access tokens; JWKS is fetched over the in-network
# Keycloak URL while the iss claim is validated against the browser-facing issuer.
API_ISSUER=http://rti.localhost:8081/realms/rti
API_JWKS_URI=http://keycloak-rti:8080/realms/rti/protocol/openid-connect/certs
API_AUDIENCE=oauth2-api
API_REQUIRED_GROUP=api-access
API_CORS_ORIGIN=http://localhost:3000
